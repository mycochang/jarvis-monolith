[Unit]
Description=Jarvis Fast Monolith (Ctrl+Space)
After=network.target ydotoold.service

[Service]
Type=simple
Environment="LD_PRELOAD=/usr/lib/libstdc++.so.6"
# Must use the uv virtual environment Python inside the new repo
ExecStart=/usr/bin/env PYTHONUNBUFFERED=1 /home/arborinisght/repos/jarvis-monolith/.venv/bin/python /home/arborinisght/repos/jarvis-monolith/jarvis.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
