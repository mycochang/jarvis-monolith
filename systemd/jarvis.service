[Unit]
Description=Jarvis Fast Monolith (Compose/Menu)
After=network.target ydotool.service

[Service]
Type=simple
Environment="LD_PRELOAD=/usr/lib/libstdc++.so.6"
# Must use the uv virtual environment Python inside the new repo
ExecStart=/usr/bin/env PYTHONUNBUFFERED=1 %h/repos/jarvis-monolith/.venv/bin/python %h/repos/jarvis-monolith/jarvis.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
